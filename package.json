{
  "name": "matchlisted",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "eslint",
    "test": "vitest run",
    "sync-board": "node scripts/sync-board.mjs",
    "demo:db": "supabase start && node scripts/demo/demo-env.mjs write",
    "demo:db:stop": "supabase stop",
    "demo:db:reset": "supabase db reset && node scripts/demo/demo-env.mjs write",
    "demo:build": "node scripts/demo/demo-env.mjs run -- next build",
    "demo:start": "node scripts/demo/demo-env.mjs run -- next start -p 3000",
    "demo:seed:before": "node scripts/demo/seed-demo.mjs --stage before",
    "demo:seed:after": "node scripts/demo/seed-demo.mjs --stage after",
    "demo:seed:live": "node scripts/demo/seed-demo.mjs --stage live",
    "demo:teardown": "node scripts/demo/seed-demo.mjs --clean"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.2",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.21.0",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.35.3",
    "stripe": "^22.3.2",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "pg": "^8.22.0",
    "supabase": "^2.118.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
