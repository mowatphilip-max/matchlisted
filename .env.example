# Matchlisted environment variables — TEMPLATE ONLY.
#
# Copy this file to `.env.local` and fill in the real values there.
# `.env.local` is git-ignored, so real keys never leave your machine.
# NEVER put real keys in this file — it IS committed to the repo.

# ---------------------------------------------------------------------------
# Supabase — the database, logins and file storage
# Find these in your Supabase project: Settings → API (and → Database for the
# connection string). Project Settings shows the same "Get Connected" panel.
# ---------------------------------------------------------------------------

# Safe to be public — this is visible in the browser by design.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Also safe to be public (the "Publishable key", starts sb_publishable_).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ⚠ SECRET — full database access, bypasses all security rules.
# The "Secret key" (starts sb_secret_). Server-side only, never in the browser.
SUPABASE_SECRET_KEY=

# ⚠ SECRET — direct Postgres connection, used to run database migrations.
# The "Direct connection string" with [YOUR-PASSWORD] replaced by the database
# password you chose when creating the project.
DATABASE_URL=

# ---------------------------------------------------------------------------
# Stripe — card payments (test keys until launch day)
# ---------------------------------------------------------------------------

# Safe to be public (starts pk_test_ / pk_live_).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ⚠ SECRET — can move money. Starts sk_test_ / sk_live_.
STRIPE_SECRET_KEY=

# ⚠ SECRET — proves a webhook genuinely came from Stripe. Starts whsec_.
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Resend — transactional email
# ---------------------------------------------------------------------------

# ⚠ SECRET — can send email as your domain. Starts re_.
RESEND_API_KEY=

# The address receipts and instructions are sent from.
EMAIL_FROM="Matchlisted <noreply@matchlisted.com>"

# Where admin notifications land.
EMAIL_ADMIN=office@mowatt.uk

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------

# Used in emailed links — must be the real domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
